<Application x:Class="NeonAudioPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/CircuitDecorations.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Runtime skin palette. All visual components bind through these brushes. -->
            <SolidColorBrush x:Key="NeonPrimary" Color="#00F6FF" />
            <SolidColorBrush x:Key="NeonSecondary" Color="#1479FF" />
            <SolidColorBrush x:Key="NeonAccent" Color="#8DFFF8" />
            <SolidColorBrush x:Key="NeonDim" Color="#063E55" />
            <SolidColorBrush x:Key="PanelBlack" Color="#EE050913" />
            <SolidColorBrush x:Key="PanelDeep" Color="#F20A1020" />
            <SolidColorBrush x:Key="PanelMid" Color="#E9162033" />
            <SolidColorBrush x:Key="TextMain" Color="#F4FBFF" />
            <SolidColorBrush x:Key="TextMuted" Color="#8296B2" />
            <SolidColorBrush x:Key="Danger" Color="#FF4365" />

            <DropShadowEffect x:Key="SoftGlow"
                              Color="#00F6FF"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.72" />
            <DropShadowEffect x:Key="StrongGlow"
                              Color="#00F6FF"
                              BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.95" />
            <DropShadowEffect x:Key="PanelShadow"
                              Color="#000000"
                              BlurRadius="36"
                              ShadowDepth="12"
                              Opacity="0.8" />

            <LinearGradientBrush x:Key="ConsoleSurface" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FA111A2A" Offset="0" />
                <GradientStop Color="#FB050914" Offset="0.52" />
                <GradientStop Color="#F9161C2A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DisplaySurface" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF06101B" Offset="0" />
                <GradientStop Color="#FF02060D" Offset="0.55" />
                <GradientStop Color="#FF09111B" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonSurface" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF202B40" Offset="0" />
                <GradientStop Color="#FF0A1020" Offset="0.55" />
                <GradientStop Color="#FF151F31" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="MicroLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource NeonPrimary}" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource NeonPrimary}" />
                <Setter Property="Effect" Value="{DynamicResource SoftGlow}" />
            </Style>

            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="Background" Value="#2218273A" />
                <Setter Property="BorderBrush" Value="#446B86A8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChromeBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="{DynamicResource NeonPrimary}" />
                                    <Setter Property="Foreground" Value="{DynamicResource NeonAccent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource NeonDim}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="MinWidth" Value="132" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Margin" Value="7" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                <Setter Property="Background" Value="{DynamicResource ButtonSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NeonDim}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="OuterGlow"
                                        Margin="-3"
                                        BorderBrush="{DynamicResource NeonPrimary}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Opacity="0" />
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <Grid>
                                        <Rectangle Height="1"
                                                   Margin="10,7,10,0"
                                                   VerticalAlignment="Top"
                                                   Fill="{DynamicResource NeonPrimary}"
                                                   Opacity="0.6" />
                                        <Rectangle Height="1"
                                                   Margin="22,0,22,7"
                                                   VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource NeonSecondary}"
                                                   Opacity="0.35" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterGlow" Property="Opacity" Value="0.8" />
                                    <Setter TargetName="OuterGlow" Property="Effect" Value="{DynamicResource SoftGlow}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource NeonPrimary}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource NeonDim}" />
                                    <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SkinButton" TargetType="Button">
                <Setter Property="Width" Value="118" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="Background" Value="#99101625" />
                <Setter Property="BorderBrush" Value="#405F718A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SkinBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Rectangle Width="4"
                                               Margin="5"
                                               HorizontalAlignment="Left"
                                               Fill="{TemplateBinding BorderBrush}" />
                                    <ContentPresenter Margin="15,0,5,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SkinBorder" Property="BorderBrush" Value="{DynamicResource NeonPrimary}" />
                                    <Setter Property="Foreground" Value="{DynamicResource NeonAccent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SkinBorder" Property="Background" Value="{DynamicResource NeonDim}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeonSlider" TargetType="Slider">
                <Setter Property="Height" Value="28" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="8"
                                        Background="#FF050A12"
                                        BorderBrush="{DynamicResource NeonDim}"
                                        BorderThickness="1"
                                        CornerRadius="4" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6"
                                                            Margin="1"
                                                            Background="{DynamicResource NeonPrimary}"
                                                            CornerRadius="3"
                                                            Effect="{DynamicResource SoftGlow}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="22">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse Fill="#FF07101B"
                                                                 Stroke="{DynamicResource NeonAccent}"
                                                                 StrokeThickness="2"
                                                                 Effect="{DynamicResource SoftGlow}" />
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="{DynamicResource NeonPrimary}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      IsTabStop="False"
                                                      Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ConsolePanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelDeep}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NeonDim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
