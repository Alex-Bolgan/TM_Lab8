<Window x:Class="NeonAudioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Neon Console Audio Player"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DrawingBrush x:Key="TechnicalGrid"
                      TileMode="Tile"
                      Viewport="0,0,42,42"
                      ViewportUnits="Absolute"
                      Opacity="0.13">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="42,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,42" />
                            <LineGeometry StartPoint="21,0" EndPoint="21,42" />
                            <LineGeometry StartPoint="0,21" EndPoint="42,21" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource NeonPrimary}"
                             Thickness="0.45" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Storyboard x:Key="ScanAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="(Canvas.Top)"
                             From="0"
                             To="242"
                             Duration="0:0:3.8" />
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="Opacity"
                             From="0.05"
                             To="0.42"
                             AutoReverse="True"
                             Duration="0:0:1.9" />
        </Storyboard>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CoreStatusLight"
                             Storyboard.TargetProperty="Opacity"
                             From="0.32"
                             To="1"
                             AutoReverse="True"
                             Duration="0:0:0.85" />
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.1"
                             To="0.65"
                             AutoReverse="True"
                             Duration="0:0:1.25" />
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ScanAnimation}" />
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="22">
        <!-- Shadow follows the polygonal console silhouette. -->
        <Path Stretch="Fill"
              Margin="4"
              Fill="#E8000000"
              Effect="{StaticResource PanelShadow}"
              Data="M 0,52 L 46,52 L 72,0 L 1108,0 L 1134,52 L 1180,52 L 1180,686 L 1132,686 L 1106,738 L 74,738 L 48,686 L 0,686 Z" />

        <Grid Clip="M 0,52 L 46,52 L 72,0 L 1108,0 L 1134,52 L 1180,52 L 1180,686 L 1132,686 L 1106,738 L 74,738 L 48,686 L 0,686 Z">
            <Path Stretch="Fill"
                  Fill="{StaticResource ConsoleSurface}"
                  Stroke="{DynamicResource NeonPrimary}"
                  StrokeThickness="2"
                  Data="M 0,52 L 46,52 L 72,0 L 1108,0 L 1134,52 L 1180,52 L 1180,686 L 1132,686 L 1106,738 L 74,738 L 48,686 L 0,686 Z"
                  Effect="{DynamicResource SoftGlow}" />

            <!-- Technical background grid -->
            <Rectangle Fill="{StaticResource TechnicalGrid}"
                       IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource CircuitBoardPattern}"
                       Opacity="0.16"
                       IsHitTestVisible="False" />

            <!-- Layered diagonal atmosphere -->
            <Canvas IsHitTestVisible="False"
                    Opacity="0.45">
                <Path Stroke="{DynamicResource NeonSecondary}"
                      StrokeThickness="1"
                      Opacity="0.5"
                      Data="M 0,150 L 180,150 L 245,85 L 490,85" />
                <Path Stroke="{DynamicResource NeonPrimary}"
                      StrokeThickness="1"
                      Opacity="0.35"
                      Data="M 1180,112 L 1015,112 L 960,57 L 800,57" />
                <Path Stroke="{DynamicResource NeonSecondary}"
                      StrokeThickness="1"
                      Opacity="0.3"
                      Data="M 0,585 L 130,585 L 202,657 L 414,657" />
                <Path Stroke="{DynamicResource NeonPrimary}"
                      StrokeThickness="1"
                      Opacity="0.35"
                      Data="M 1180,603 L 1052,603 L 984,671 L 820,671" />
                <Path Stroke="{DynamicResource NeonDim}"
                      StrokeThickness="8"
                      Data="M 0,178 L 36,178 L 62,152" />
                <Path Stroke="{DynamicResource NeonDim}"
                      StrokeThickness="8"
                      Data="M 1180,178 L 1144,178 L 1118,152" />
                <Path Stroke="{DynamicResource NeonDim}"
                      StrokeThickness="8"
                      Data="M 0,548 L 36,548 L 62,574" />
                <Path Stroke="{DynamicResource NeonDim}"
                      StrokeThickness="8"
                      Data="M 1180,548 L 1144,548 L 1118,574" />
            </Canvas>

            <Grid Margin="58,18,58,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="276" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="104" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="126" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="42"
                          Height="42">
                        <Ellipse Stroke="{DynamicResource NeonPrimary}"
                                 StrokeThickness="1"
                                 Opacity="0.7" />
                        <Ellipse Width="30"
                                 Height="30"
                                 Stroke="{DynamicResource NeonSecondary}"
                                 StrokeThickness="2"
                                 Opacity="0.8" />
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Fill="{DynamicResource NeonAccent}"
                              Effect="{DynamicResource SoftGlow}"
                              Data="M 2,5 L 7,5 L 7,2 L 10,2 L 10,14 L 7,14 L 7,11 L 2,11 Z M 11,5 L 16,3 L 16,13 L 11,11 Z" />
                    </Grid>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock FontFamily="Consolas"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource NeonAccent}"
                                   Text="NEON CONSOLE // AUDIO DECK"
                                   Effect="{DynamicResource SoftGlow}" />
                        <TextBlock Margin="1,2,0,0"
                                   Style="{StaticResource MicroLabel}"
                                   Text="NX-08  •  MEDIA CORE ONLINE  •  LOCAL STREAM INTERFACE" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Margin="0,0,12,0"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Background="#44122634"
                                BorderBrush="{DynamicResource NeonDim}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource NeonPrimary}"
                                         Effect="{DynamicResource SoftGlow}" />
                                <TextBlock Style="{StaticResource MicroLabel}"
                                           Text="SYSTEM ACTIVE" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource ChromeButton}"
                                ToolTip="Minimize"
                                Click="Minimize_Click">
                            <Path Width="12"
                                  Height="2"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  Data="M 0,0 L 12,0 L 12,2 L 0,2 Z" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}"
                                ToolTip="Close"
                                Click="Close_Click">
                            <Path Width="11"
                                  Height="11"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.6"
                                  Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Central display and telemetry -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="172" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="212" />
                    </Grid.ColumnDefinitions>

                    <!-- Left telemetry rail -->
                    <Border Grid.Column="0"
                            Style="{StaticResource ConsolePanel}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionLabel}"
                                       Text="SIGNAL MATRIX" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Width="9"
                                           Height="64"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonPrimary}"
                                           Opacity="0.4" />
                                <Rectangle Grid.Column="1"
                                           Width="9"
                                           Height="104"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonPrimary}"
                                           Opacity="0.55" />
                                <Rectangle Grid.Column="2"
                                           Width="9"
                                           Height="86"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonSecondary}"
                                           Opacity="0.7" />
                                <Rectangle Grid.Column="3"
                                           Width="9"
                                           Height="138"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonPrimary}"
                                           Opacity="0.85"
                                           Effect="{DynamicResource SoftGlow}" />
                                <Rectangle Grid.Column="4"
                                           Width="9"
                                           Height="116"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonSecondary}"
                                           Opacity="0.7" />
                                <Rectangle Grid.Column="5"
                                           Width="9"
                                           Height="76"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonPrimary}"
                                           Opacity="0.55" />
                                <Rectangle Grid.Column="6"
                                           Width="9"
                                           Height="96"
                                           VerticalAlignment="Bottom"
                                           Fill="{DynamicResource NeonPrimary}"
                                           Opacity="0.45" />
                            </Grid>
                            <StackPanel Grid.Row="3">
                                <Grid Margin="0,3">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="BUFFER" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="100%" />
                                </Grid>
                                <ProgressBar Height="4"
                                             Maximum="100"
                                             Value="100"
                                             Foreground="{DynamicResource NeonPrimary}"
                                             Background="#FF07101A"
                                             BorderThickness="0" />
                                <Grid Margin="0,9,0,3">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="OUTPUT" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="STEREO" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main holographic display -->
                    <Border Grid.Column="2"
                            Background="{StaticResource DisplaySurface}"
                            BorderBrush="{DynamicResource NeonPrimary}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Effect="{DynamicResource SoftGlow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>

                            <Grid Margin="18,0">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MicroLabel}"
                                           Text="TRACK CHANNEL / LOCAL MEDIA" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Rectangle Width="28"
                                               Height="2"
                                               Margin="0,0,8,0"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.7" />
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="CH-01" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="18,0">
                                <Canvas ClipToBounds="True"
                                        IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="0"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="30"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="60"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="90"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="120"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle Canvas.Left="0"
                                               Canvas.Top="150"
                                               Width="840"
                                               Height="1"
                                               Fill="{DynamicResource NeonPrimary}"
                                               Opacity="0.09" />
                                    <Rectangle x:Name="ScanLine"
                                               Canvas.Left="0"
                                               Canvas.Top="0"
                                               Width="840"
                                               Height="2"
                                               Fill="{DynamicResource NeonAccent}"
                                               Opacity="0.2"
                                               Effect="{DynamicResource SoftGlow}" />
                                </Canvas>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Grid VerticalAlignment="Center">
                                        <Ellipse x:Name="PulseRing"
                                                 Width="68"
                                                 Height="68"
                                                 Stroke="{DynamicResource NeonPrimary}"
                                                 StrokeThickness="1"
                                                 Opacity="0.4" />
                                        <Ellipse Width="48"
                                                 Height="48"
                                                 Stroke="{DynamicResource NeonSecondary}"
                                                 StrokeThickness="2"
                                                 StrokeDashArray="2,2" />
                                        <Ellipse x:Name="CoreStatusLight"
                                                 Width="18"
                                                 Height="18"
                                                 Fill="{DynamicResource NeonPrimary}"
                                                 Effect="{DynamicResource StrongGlow}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource MicroLabel}"
                                                   Text="NOW LINKED TO" />
                                        <TextBlock x:Name="TrackTitleText"
                                                   Margin="0,8,0,7"
                                                   FontFamily="Consolas"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMain}"
                                                   Text="NO AUDIO SOURCE"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="No file selected" />
                                        <Border Width="280"
                                                Height="2"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource NeonPrimary}"
                                                Effect="{DynamicResource SoftGlow}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   Style="{StaticResource MicroLabel}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="SELECT A LOCAL AUDIO SIGNAL TO INITIALIZE" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Style="{StaticResource MicroLabel}"
                                                   Text="CORE STATUS" />
                                        <TextBlock x:Name="StatusText"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="Consolas"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource NeonAccent}"
                                                   Text="STANDBY"
                                                   Effect="{DynamicResource SoftGlow}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Margin="0,0,6,0"
                                             Fill="{DynamicResource NeonPrimary}" />
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="DECODER READY" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MicroLabel}"
                                           Text="WAVEFORM BUS // 48 kHz" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MicroLabel}"
                                           Text="LATENCY 08 ms" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right diagnostics rail -->
                    <Border Grid.Column="4"
                            Style="{StaticResource ConsolePanel}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionLabel}"
                                       Text="CORE DIAGNOSTICS" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Ellipse Stroke="{DynamicResource NeonDim}"
                                             StrokeThickness="6" />
                                    <Path Margin="7"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource NeonPrimary}"
                                          StrokeThickness="5"
                                          Data="M 7,41 A 34,34 0 1 1 41,75"
                                          Effect="{DynamicResource SoftGlow}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="96" />
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="PROCESSOR" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="NOMINAL" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="STABLE CLOCK" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="4">
                                <Grid Margin="0,2">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="AUDIO BUS" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="ARMED" />
                                </Grid>
                                <Rectangle Height="1"
                                           Margin="0,5"
                                           Fill="{DynamicResource NeonDim}" />
                                <Grid Margin="0,2">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="TIMELINE" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="SYNC" />
                                </Grid>
                                <Rectangle Height="1"
                                           Margin="0,5"
                                           Fill="{DynamicResource NeonDim}" />
                                <Grid Margin="0,2">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="SKIN MATRIX" />
                                    <TextBlock x:Name="ActiveSkinText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="CYAN" />
                                </Grid>
                                <Rectangle Height="1"
                                           Margin="0,5"
                                           Fill="{DynamicResource NeonDim}" />
                                <Grid Margin="0,2">
                                    <TextBlock Style="{StaticResource MicroLabel}"
                                               Text="SECURITY" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource MicroLabel}"
                                               Foreground="{DynamicResource NeonAccent}"
                                               Text="LOCAL" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Timeline module -->
                <Border Grid.Row="4"
                        Style="{StaticResource ConsolePanel}"
                        Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionLabel}"
                                       Text="TEMPORAL NAVIGATION" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock x:Name="CurrentTimeText"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource NeonAccent}"
                                           Text="00:00" />
                                <TextBlock Margin="7,0"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMuted}"
                                           Text="/" />
                                <TextBlock x:Name="DurationText"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMain}"
                                           Text="00:00" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1"
                              Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <Path Width="12"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NeonPrimary}"
                                  Data="M 10,0 L 0,7 L 10,14 Z" />
                            <Slider x:Name="SeekSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    IsEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    Style="{StaticResource NeonSlider}"
                                    PreviewMouseLeftButtonDown="SeekSlider_DragStarted"
                                    PreviewMouseLeftButtonUp="SeekSlider_DragCompleted"
                                    ValueChanged="SeekSlider_ValueChanged" />
                            <Path Grid.Column="2"
                                  Width="12"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NeonPrimary}"
                                  Data="M 0,0 L 10,7 L 0,14 Z" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Transport and volume control deck -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="304" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource ConsolePanel}"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="9,0">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="TRANSPORT ARRAY" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource MicroLabel}"
                                           Text="MANUAL CONTROL ENABLED" />
                            </Grid>
                            <UniformGrid Grid.Row="1"
                                         Columns="4"
                                         VerticalAlignment="Center">
                                <Button Style="{StaticResource TransportButton}"
                                        ToolTip="Choose an audio file"
                                        Click="OpenFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="24"
                                              Height="21"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource NeonPrimary}"
                                              StrokeThickness="1.8"
                                              Data="M 1,4 L 9,4 L 12,7 L 23,7 L 23,20 L 1,20 Z M 1,7 L 23,7" />
                                        <StackPanel>
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Text="OPEN" />
                                            <TextBlock Style="{StaticResource MicroLabel}"
                                                       Text="SOURCE" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        ToolTip="Play"
                                        Click="Play_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="22"
                                              Height="23"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource NeonPrimary}"
                                              Data="M 2,1 L 21,12 L 2,23 Z"
                                              Effect="{DynamicResource SoftGlow}" />
                                        <StackPanel>
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Text="PLAY" />
                                            <TextBlock Style="{StaticResource MicroLabel}"
                                                       Text="ENGAGE" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        ToolTip="Pause or resume"
                                        Click="PauseResume_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="22"
                                              Height="23"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center">
                                            <Rectangle Width="7"
                                                       HorizontalAlignment="Left"
                                                       Fill="{DynamicResource NeonPrimary}"
                                                       Effect="{DynamicResource SoftGlow}" />
                                            <Rectangle Width="7"
                                                       HorizontalAlignment="Right"
                                                       Fill="{DynamicResource NeonPrimary}"
                                                       Effect="{DynamicResource SoftGlow}" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="PauseResumeText"
                                                       FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Text="PAUSE" />
                                            <TextBlock Style="{StaticResource MicroLabel}"
                                                       Text="HOLD / RESUME" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TransportButton}"
                                        ToolTip="Stop"
                                        Click="Stop_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="20"
                                                   Height="20"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource NeonPrimary}"
                                                   Effect="{DynamicResource SoftGlow}" />
                                        <StackPanel>
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Text="STOP" />
                                            <TextBlock Style="{StaticResource MicroLabel}"
                                                       Text="RESET" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource ConsolePanel}"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="OUTPUT LEVEL" />
                                <TextBlock x:Name="VolumeText"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource NeonAccent}"
                                           Text="70%" />
                            </Grid>
                            <Grid Grid.Row="1"
                                  Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource NeonPrimary}"
                                      Data="M 1,7 L 6,7 L 12,2 L 12,18 L 6,13 L 1,13 Z M 15,7 A 5,5 0 0 1 15,13"
                                      Effect="{DynamicResource SoftGlow}" />
                                <Slider x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="70"
                                        Style="{StaticResource NeonSlider}"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource MicroLabel}"
                                       Text="MASTER CHANNEL" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Skin dock and footer -->
                <Grid Grid.Row="7"
                      Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MicroLabel}"
                                   Text="SKIN://" />
                        <Button Style="{StaticResource SkinButton}"
                                BorderBrush="#00F6FF"
                                Content="CYAN CIRCUIT"
                                Tag="Cyan|#00F6FF|#1479FF|#8DFFF8|#063E55"
                                Click="SkinButton_Click" />
                        <Button Style="{StaticResource SkinButton}"
                                BorderBrush="#FF2BD6"
                                Content="MAGENTA PULSE"
                                Tag="Magenta|#FF2BD6|#A73CFF|#FFB3F2|#5B0A50"
                                Click="SkinButton_Click" />
                        <Button Style="{StaticResource SkinButton}"
                                BorderBrush="#9C6CFF"
                                Content="ULTRAVIOLET"
                                Tag="Ultraviolet|#9C6CFF|#4F7CFF|#D6C6FF|#301C68"
                                Click="SkinButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="22,0"
                                VerticalAlignment="Center">
                        <Rectangle Height="1"
                                   Fill="{DynamicResource NeonDim}" />
                        <Rectangle Width="120"
                                   Height="2"
                                   HorizontalAlignment="Center"
                                   Fill="{DynamicResource NeonPrimary}"
                                   Effect="{DynamicResource SoftGlow}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MicroLabel}"
                                   Text="WPF AUDIO MATRIX" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{StaticResource MicroLabel}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="BUILD 08.26" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Decorative corner hardware -->
            <Canvas IsHitTestVisible="False">
                <Rectangle Canvas.Left="20"
                           Canvas.Top="84"
                           Width="10"
                           Height="88"
                           Fill="{DynamicResource NeonDim}" />
                <Rectangle Canvas.Left="24"
                           Canvas.Top="92"
                           Width="2"
                           Height="72"
                           Fill="{DynamicResource NeonPrimary}"
                           Effect="{DynamicResource SoftGlow}" />
                <Rectangle Canvas.Right="20"
                           Canvas.Top="84"
                           Width="10"
                           Height="88"
                           Fill="{DynamicResource NeonDim}" />
                <Rectangle Canvas.Right="24"
                           Canvas.Top="92"
                           Width="2"
                           Height="72"
                           Fill="{DynamicResource NeonPrimary}"
                           Effect="{DynamicResource SoftGlow}" />
                <Rectangle Canvas.Left="20"
                           Canvas.Bottom="84"
                           Width="10"
                           Height="88"
                           Fill="{DynamicResource NeonDim}" />
                <Rectangle Canvas.Left="24"
                           Canvas.Bottom="92"
                           Width="2"
                           Height="72"
                           Fill="{DynamicResource NeonPrimary}"
                           Effect="{DynamicResource SoftGlow}" />
                <Rectangle Canvas.Right="20"
                           Canvas.Bottom="84"
                           Width="10"
                           Height="88"
                           Fill="{DynamicResource NeonDim}" />
                <Rectangle Canvas.Right="24"
                           Canvas.Bottom="92"
                           Width="2"
                           Height="72"
                           Fill="{DynamicResource NeonPrimary}"
                           Effect="{DynamicResource SoftGlow}" />
                <Ellipse Canvas.Left="34"
                         Canvas.Top="28"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource NeonPrimary}"
                         Effect="{DynamicResource SoftGlow}" />
                <Ellipse Canvas.Right="34"
                         Canvas.Top="28"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource NeonPrimary}"
                         Effect="{DynamicResource SoftGlow}" />
                <Ellipse Canvas.Left="34"
                         Canvas.Bottom="28"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource NeonPrimary}"
                         Effect="{DynamicResource SoftGlow}" />
                <Ellipse Canvas.Right="34"
                         Canvas.Bottom="28"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource NeonPrimary}"
                         Effect="{DynamicResource SoftGlow}" />
            </Canvas>
        </Grid>

        <MediaElement x:Name="AudioEngine"
                      Width="1"
                      Height="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      ScrubbingEnabled="True"
                      Visibility="Hidden"
                      MediaOpened="AudioEngine_MediaOpened"
                      MediaEnded="AudioEngine_MediaEnded"
                      MediaFailed="AudioEngine_MediaFailed" />
    </Grid>
</Window>
